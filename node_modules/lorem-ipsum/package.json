{
  "name": "lorem-ipsum",
  "version": "3.0.0",
  "description": "Generates lorem ipsum placeholder text for Node.js, Deno, browsers, and React Native. Developed with Bun.",
  "author": "Nickolas Kenyeres <dev@kenyeres.ca> (https://codeberg.org/nickolas)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://codeberg.org/nickolas/lorem-ipsum.js.git"
  },
  "bugs": {
    "url": "https://codeberg.org/nickolas/lorem-ipsum.js/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "unpkg": "./dist/index.browser.min.js",
  "jsdelivr": "./dist/index.browser.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "unpkg": "./dist/index.browser.min.js",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./browser": "./dist/index.browser.js",
    "./browser.min": "./dist/index.browser.min.js"
  },
  "bin": {
    "lorem-ipsum": "./dist/cli.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "tag": "latest"
  },
  "scripts": {
    "dev": "bun test --watch",
    "build": "bun run scripts/build.js",
    "test": "bun test",
    "prepublishOnly": "bun test && bun run build",
    "publish:npm": "bun publish"
  },
  "keywords": [
    "lorem",
    "ipsum",
    "placeholder",
    "text",
    "dummy",
    "filler",
    "node",
    "deno",
    "bun",
    "browser",
    "react-native"
  ],
  "packageManager": "bun@1.3.13",
  "dependencies": {},
  "devDependencies": {}
}
