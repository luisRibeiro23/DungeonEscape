<h1 style="margin-bottom: 24px;">🏆 Ranking</h1>

{{#if error}}
    <div style="background:#fee2e2; border:1px solid #fca5a5; color:#b91c1c; border-radius:4px; padding:10px 14px; margin-bottom:16px;">
        {{error}}
    </div>
{{/if}}

{{#if ranking.length}}
<table style="width:100%; border-collapse:collapse; font-size:0.95rem;">
    <thead>
        <tr style="background:#1e3a5f; color:#fff;">
            <th style="padding:12px 16px; text-align:center; width:60px;">#</th>
            <th style="padding:12px 16px; text-align:left;">Jogador</th>
            <th style="padding:12px 16px; text-align:left;">Curso</th>
            <th style="padding:12px 16px; text-align:center;">Pontuação</th>
        </tr>
    </thead>
    <tbody>
        {{#each ranking}}
        <tr style="background: {{#if (eq @index 0)}}#fff8e1{{else if (eq @index 1)}}#f5f5f5{{else if (eq @index 2)}}#fbe9e7{{else}}#fff{{/if}}; border-bottom: 1px solid #e5e7eb;">
            <td style="padding:12px 16px; text-align:center; font-weight:700; font-size:1.1rem;">
                {{#if (eq @index 0)}}🥇{{else if (eq @index 1)}}🥈{{else if (eq @index 2)}}🥉{{else}}{{add @index 1}}{{/if}}
            </td>
            <td style="padding:12px 16px;">{{fullname}}</td>
            <td style="padding:12px 16px; color:#6b7280;">{{major}}</td>
            <td style="padding:12px 16px; text-align:center; font-weight:700; color:#1e3a5f;">{{score}}</td>
        </tr>
        {{/each}}
    </tbody>
</table>
{{else}}
    <p style="color:#6b7280;">Nenhuma partida registrada ainda. Jogue para aparecer no ranking!</p>
{{/if}}

<div style="margin-top: 24px;">
    <a href="/" style="color:#2563eb; text-decoration:none; font-size:0.9rem;">← Voltar ao jogo</a>
</div>