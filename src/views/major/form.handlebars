<div style="display:flex; justify-content:center; align-items:flex-start; min-height:80vh; padding-top:40px;">
    <div style="width:100%; max-width:480px;">
        <h1 style="margin-bottom:24px;">{{#if data}}Editar Curso{{else}}Criação de Curso{{/if}}</h1>

        <form action='/major/{{#if data}}update/{{data.id}}{{else}}create{{/if}}' method='POST'>
            <div class='form-group'>
                <label for='name'>Name</label>
                <input type='text' id='name' name='name' value='{{data.name}}' maxlength='100' />
            </div>

            <div class='form-group'>
                <label for='code'>Sigla</label>
                <input type='text' id='code' name='code' value='{{data.code}}' maxlength='4' />
            </div>

            <div class='form-group'>
                <label for='description'>Descrição</label>
                <textarea id='description' name='description' rows='3'>{{data.description}}</textarea>
            </div>

            <button type='submit'>Enviar</button>
        </form>
    </div>
</div>