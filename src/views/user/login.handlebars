<div style="display:flex; justify-content:center; align-items:flex-start; min-height:80vh; padding-top:40px;">
    <div style="width:100%; max-width:400px;">
        <h1 style="margin-bottom:24px;">Entrar</h1>

        {{#if error}}
            <div style="background:#fee2e2; border:1px solid #fca5a5; color:#b91c1c; border-radius:4px; padding:10px 14px; margin-bottom:16px; font-size:0.9rem;">
                {{error}}
            </div>
        {{/if}}

        <form action='/user/login' method='POST'>
            <div class='form-group'>
                <label for='email'>E-mail</label>
                <input type='email' id='email' name='email' value='{{formData.email}}' placeholder='seu@email.com' required />
            </div>

            <div class='form-group'>
                <label for='password'>Senha</label>
                <input type='password' id='password' name='password' placeholder='Sua senha' required />
            </div>

            <div style='margin-top:20px; display:flex; gap:12px; align-items:center;'>
                <button type='submit'>Entrar</button>
                <a href='/user/register' style='color:#6b7280; font-size:0.9rem; text-decoration:none;'>Criar conta</a>
            </div>
        </form>
    </div>
</div>