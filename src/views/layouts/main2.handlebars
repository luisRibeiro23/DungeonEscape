<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DungeonEscape</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/game/css/style.css">
    <link rel="stylesheet" href="/game/css/menu.css">
    <link rel="stylesheet" href="/game/css/game.css">
    <link rel="stylesheet" href="/game/css/mapEffects.css">
    <link rel="stylesheet" href="/game/css/sumon-and-timer.css">
    <link rel="stylesheet" href="/game/css/projectile.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">🏰 DungeonEscape</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav2">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav2">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/about">Sobre</a>
                    </li>
                    {{#if isLoggedIn}}
                        <li class="nav-item">
                            <a class="nav-link" href="/">Jogar</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/ranking">Ranking</a>
                        </li>
                        <li class="nav-item">
                            <form action="/user/logout" method="POST" class="d-inline">
                                <button type="submit" class="btn btn-outline-light btn-sm ms-2">Sair</button>
                            </form>
                        </li>
                    {{else}}
                        <li class="nav-item">
                            <a class="nav-link" href="/user/login">Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/user/register">Criar Conta</a>
                        </li>
                    {{/if}}
                </ul>
            </div>
        </div>
    </nav>

    {{{body}}}

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>